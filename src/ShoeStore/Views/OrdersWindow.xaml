<Window x:Class="ShoeStore.Views.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказы — Магазин обуви «Шаг»"
        Width="980" Height="600" MinWidth="720" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindowStyle}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Заказы" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Все заказы магазина. Нажмите на заголовок столбца, чтобы отсортировать."
                       Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Таблица в карточке; ClipToBounds не скругляет углы, поэтому отступ внутри карточки -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="1">
            <DataGrid x:Name="OrdersDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" Margin="0,6,0,6">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding OrderId}" Width="70"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding OrderDate}" Width="120"/>
                    <DataGridTextColumn Header="Клиент" Binding="{Binding CustomerName}" Width="220"/>
                    <DataGridTemplateColumn Header="Статус" Width="130" SortMemberPath="Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Новый">
                                                    <Setter Property="Background" Value="{StaticResource InfoSoftBrush}"/>
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource InfoBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Выдан">
                                                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource SuccessBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Завершен">
                                                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Состав заказа" Binding="{Binding Items}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Button Grid.Row="2" Style="{StaticResource SecondaryButton}" Margin="0,16,0,0" HorizontalAlignment="Left"
                IsCancel="True" Click="BackButton_Click">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72B;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                <TextBlock Text="Назад"/>
            </StackPanel>
        </Button>
    </Grid>
</Window>

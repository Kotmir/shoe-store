<Window x:Class="ShoeStore.Views.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказы — Магазин обуви «Шаг»"
        Width="900" Height="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <DockPanel Margin="12">
        <Button DockPanel.Dock="Bottom" Content="Назад" HorizontalAlignment="Left" Click="BackButton_Click"/>
        <DataGrid x:Name="OrdersDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding OrderId}" Width="60"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding OrderDate}" Width="110"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding CustomerName}" Width="200"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="110"/>
                <DataGridTextColumn Header="Состав заказа" Binding="{Binding Items}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>

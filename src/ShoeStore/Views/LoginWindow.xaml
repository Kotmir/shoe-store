<Window x:Class="ShoeStore.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход — Магазин обуви «Шаг»"
        Width="420" Height="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <StackPanel VerticalAlignment="Center" Margin="40,20">

        <Image x:Name="LogoImage" Height="80" Margin="0,0,0,10"/>

        <TextBlock Text="Магазин обуви «Шаг»" FontSize="22" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Text="Логин"/>
        <TextBox x:Name="LoginTextBox" Margin="0,4,0,12" MaxLength="50"/>

        <TextBlock Text="Пароль"/>
        <PasswordBox x:Name="PasswordBox" Margin="0,4,0,16" Padding="4" MaxLength="50"/>

        <Button Content="Войти" IsDefault="True" Click="LoginButton_Click" Margin="0,4"/>
        <Button Content="Войти как гость" Click="GuestButton_Click" Margin="0,4"
                Background="#90A4AE"/>

    </StackPanel>
</Window>

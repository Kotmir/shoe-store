<Window x:Class="ShoeStore.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход — Магазин обуви «Шаг»"
        Width="880" Height="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindowStyle}"
        Background="{StaticResource SurfaceBrush}"
        FocusManager.FocusedElement="{Binding ElementName=LoginTextBox}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель: бренд -->
        <Grid Grid.Column="0" Background="{StaticResource PrimaryBrush}" ClipToBounds="True">
            <!-- Декоративные круги -->
            <Ellipse Width="420" Height="420" Fill="{StaticResource AccentBrush}" Opacity="0.18"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-180,0,0,-220"/>
            <Ellipse Width="220" Height="220" Fill="{StaticResource AccentBrush}" Opacity="0.12"
                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-90,-90,0"/>

            <DockPanel Margin="40">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <Image x:Name="LogoImage" Height="44" MaxWidth="160" Stretch="Uniform"/>
                    <!-- Знак-заглушка, пока нет файла Images/logo.png -->
                    <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource AccentBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Source, ElementName=LogoImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Ш" FontSize="22" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="© Магазин обуви «Шаг»" FontSize="12"
                           Foreground="White" Opacity="0.5"/>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Шаг" FontSize="44" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="магазин обуви" FontSize="18" Foreground="White" Opacity="0.75" Margin="0,0,0,20"/>
                    <TextBlock Text="Каталог, наличие и цены — в одном месте. Войдите, чтобы работать с товарами и заказами."
                               FontSize="14" LineHeight="22" Foreground="White" Opacity="0.65" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- Правая панель: форма входа -->
        <StackPanel Grid.Column="1" Width="340" VerticalAlignment="Center">
            <TextBlock Text="Вход в систему" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Введите логин и пароль, выданные администратором."
                       Style="{StaticResource MutedText}" Margin="0,6,0,28"/>

            <TextBlock Text="Логин" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="LoginTextBox" Tag="Введите логин" MaxLength="50" MinHeight="42" Margin="0,0,0,16"/>

            <TextBlock Text="Пароль" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="PasswordBox" MaxLength="50" MinHeight="42" Margin="0,0,0,24"/>

            <Button Content="Войти" IsDefault="True" Height="42" Click="LoginButton_Click"/>

            <!-- Разделитель «или» -->
            <Grid Margin="0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="1" Background="{StaticResource DividerBrush}"/>
                <TextBlock Grid.Column="1" Text="или" Margin="12,0" FontSize="12" Style="{StaticResource MutedText}"/>
                <Border Grid.Column="2" Height="1" Background="{StaticResource DividerBrush}"/>
            </Grid>

            <Button Content="Войти как гость" Height="42" Style="{StaticResource SecondaryButton}"
                    Click="GuestButton_Click"/>
            <TextBlock Text="Гость может только просматривать каталог."
                       Style="{StaticResource FieldHint}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>

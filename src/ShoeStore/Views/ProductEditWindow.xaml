<Window x:Class="ShoeStore.Views.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар"
        Width="640" Height="760" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <DockPanel Margin="0,4">
                <TextBlock Text="Фото" Width="180" DockPanel.Dock="Left"/>
                <StackPanel>
                    <Border BorderBrush="Gray" BorderThickness="1" Width="300" Height="200" HorizontalAlignment="Left">
                        <Image x:Name="PreviewImage" Stretch="Uniform"/>
                    </Border>
                    <Button Content="Выбрать фото…" HorizontalAlignment="Left" Margin="0,6,0,0"
                            Click="ChooseImageButton_Click"/>
                    <TextBlock Text="Не более 300×200 пикселей" Foreground="Gray"/>
                </StackPanel>
            </DockPanel>

            <!-- ID: при добавлении скрыт, при редактировании только для чтения -->
            <DockPanel x:Name="IdPanel" Margin="0,4">
                <TextBlock Text="ID товара" Width="180" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <TextBox x:Name="IdTextBox" IsReadOnly="True" Background="#F0F0F0"/>
            </DockPanel>

            <DockPanel Margin="0,4">
                <TextBlock Text="Наименование *" Width="180" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <TextBox x:Name="NameTextBox" MaxLength="150"/>
            </DockPanel>

            <DockPanel Margin="0,4">
                <TextBlock Text="Категория *" Width="180" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <ComboBox x:Name="CategoryComboBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
            </DockPanel>

            <DockPanel Margin="0,4">
                <TextBlock Text="Описание" Width="180" DockPanel.Dock="Left"/>
                <TextBox x:Name="DescriptionTextBox" Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" MaxLength="500"/>
            </DockPanel>

            <DockPanel Margin="0,4">
                <TextBlock Text="Производитель *" Width="180" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <ComboBox x:Name="ManufacturerComboBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
            </DockPanel>

            <DockPanel Margin="0,4">
                <TextBlock Text="Поставщик *" Width="180" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <ComboBox x:Name="SupplierComboBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
            </DockPanel>

            <DockPanel Margin="0,4">
                <TextBlock Text="Цена, ₽ *" Width="180" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <TextBox x:Name="PriceTextBox" MaxLength="12"
                         ToolTip="Число не меньше 0, можно с копейками (например, 1999.90)"
                         PreviewTextInput="PriceTextBox_PreviewTextInput"/>
            </DockPanel>

            <DockPanel Margin="0,4">
                <TextBlock Text="Единица измерения *" Width="180" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <ComboBox x:Name="UnitComboBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
            </DockPanel>

            <DockPanel Margin="0,4">
                <TextBlock Text="Количество на складе *" Width="180" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <TextBox x:Name="StockTextBox" MaxLength="9"
                         ToolTip="Целое число не меньше 0"
                         PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
            </DockPanel>

            <DockPanel Margin="0,4">
                <TextBlock Text="Действующая скидка, % *" Width="180" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <TextBox x:Name="DiscountTextBox" MaxLength="3"
                         ToolTip="Целое число от 0 до 100"
                         PreviewTextInput="IntegerTextBox_PreviewTextInput"/>
            </DockPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Сохранить" IsDefault="True" Click="SaveButton_Click"/>
                <Button Content="Назад" Background="#90A4AE" IsCancel="True" Click="BackButton_Click"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>

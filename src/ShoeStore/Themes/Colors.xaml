<!--
    Палитра и типографика приложения.
    Все цвета задаются только здесь: чтобы сменить оформление (например, под руководство по стилю),
    достаточно поправить значения в этом файле.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Шрифты -->
    <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Базовые цвета -->
    <Color x:Key="PageBackgroundColor">#F4F4F5</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#FAFAFA</Color>
    <Color x:Key="SurfaceHoverColor">#F4F4F5</Color>
    <Color x:Key="SurfacePressedColor">#E4E4E7</Color>

    <Color x:Key="TextColor">#18181B</Color>
    <Color x:Key="TextSecondaryColor">#3F3F46</Color>
    <Color x:Key="MutedTextColor">#71717A</Color>

    <Color x:Key="BorderColor">#E4E4E7</Color>
    <Color x:Key="InputBorderColor">#D4D4D8</Color>
    <Color x:Key="InputBorderHoverColor">#A1A1AA</Color>

    <!-- Основная кнопка: «чернильный» цвет -->
    <Color x:Key="PrimaryColor">#18181B</Color>
    <Color x:Key="PrimaryHoverColor">#3F3F46</Color>
    <Color x:Key="PrimaryPressedColor">#52525B</Color>

    <!-- Фирменный акцент: логотип, фокус, выделение, скидки -->
    <Color x:Key="AccentColor">#EA580C</Color>
    <Color x:Key="AccentDarkColor">#C2410C</Color>
    <Color x:Key="AccentSoftColor">#FFF1E8</Color>
    <Color x:Key="FocusRingColor">#59EA580C</Color>

    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="DangerSoftColor">#FEF2F2</Color>
    <Color x:Key="SuccessColor">#15803D</Color>
    <Color x:Key="SuccessSoftColor">#DCFCE7</Color>
    <Color x:Key="InfoColor">#1D4ED8</Color>
    <Color x:Key="InfoSoftColor">#DBEAFE</Color>

    <Color x:Key="ShadowColor">#18181B</Color>

    <!-- Цвета из технического задания (подсветка товаров и цен) -->
    <Color x:Key="BigDiscountColor">#2E8B57</Color>
    <Color x:Key="OutOfStockColor">#ADD8E6</Color>
    <Color x:Key="OldPriceColor">#D32F2F</Color>
    <Color x:Key="FinalPriceColor">#000000</Color>

    <!-- Кисти -->
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource PageBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource SurfacePressedColor}"/>

    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}"/>

    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}"/>
    <SolidColorBrush x:Key="InputBorderHoverBrush" Color="{StaticResource InputBorderHoverColor}"/>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource FocusRingColor}"/>

    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="InfoSoftBrush" Color="{StaticResource InfoSoftColor}"/>

    <SolidColorBrush x:Key="BigDiscountBrush" Color="{StaticResource BigDiscountColor}"/>
    <SolidColorBrush x:Key="OutOfStockBrush" Color="{StaticResource OutOfStockColor}"/>
    <SolidColorBrush x:Key="OldPriceBrush" Color="{StaticResource OldPriceColor}"/>
    <SolidColorBrush x:Key="FinalPriceBrush" Color="{StaticResource FinalPriceColor}"/>

    <!-- Скругления -->
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">999</CornerRadius>

</ResourceDictionary>
